{
  "schema": "cablesim.plugin/2",
  "id": "cablesim.thermal-network",
  "version": "1.0.1",
  "name": "交叉校核参考",
  "description": "简化热网络用于同输入方法对比；附加损耗系数须显式给定。",
  "icon": "assets/icon.svg",
  "presentation": {
    "category": "calculation",
    "category_title": "计算方法",
    "assets": [
      {
        "role": "cover",
        "path": "assets/cover.webp",
        "title": "交叉校核参考封面",
        "description": "仓库既有插件封面，随发行包封签。",
        "media_type": "image/webp"
      },
      {
        "role": "method",
        "path": "assets/method.svg",
        "title": "交叉校核参考方法示意",
        "description": "按实际模型手工绘制的示意图；不包含虚构结果。",
        "media_type": "image/svg+xml"
      }
    ],
    "validation_note": "无参考算例可发布数值数据；已声明的源码测试与适用范围见各能力validation，不据此生成验证图。"
  },
  "publisher": {
    "id": "cablesim",
    "name": "CableSimPro"
  },
  "host_api": {
    "major": 2,
    "min_minor": 1
  },
  "license": {
    "spdx": "LicenseRef-Project-Undeclared",
    "review_required": false
  },
  "platforms": [
    "windows-x64",
    "linux-x64",
    "darwin-arm64",
    "darwin-x64"
  ],
  "runtime": {
    "kind": "python",
    "python": ">=3.11,<3.14",
    "entry": "src/cablesim_thermal_network/main.py"
  },
  "permissions": [
    "study.run",
    "artifact.write"
  ],
  "dependencies": [],
  "resources": {
    "timeout_s": 60,
    "memory_mb": 512,
    "network": "none"
  },
  "capabilities": [
    {
      "kind": "method",
      "id": "steady-rating",
      "title": "简化热网络交叉校核参考",
      "method_version": "1.0.0",
      "analysis": "crosscheck",
      "input_schema": "cablesim.domain/1",
      "outputs": [
        {
          "key": "ampacity",
          "type": "quantity",
          "per": "circuit",
          "required": true
        },
        {
          "key": "conductor_temperature",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "losses.dielectric",
          "type": "quantity",
          "per": "cable",
          "required": false
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.thermal-network-rating",
          "required": true
        },
        {
          "type": "x-cablesim.headline-witness",
          "required": false
        }
      ],
      "validation": {
        "level": "unverified",
        "cases": []
      },
      "limitations": [
        "单回路三根相同无铠装单芯电缆，均匀土壤、恒温地表。",
        "交流附加系数与屏蔽损耗系数为输入假设，不自动计算集肤、邻近或护套环流。",
        "不是完整 IEC 60287 实现；经 TB 880 验证的方法见 cablesim.iec60287。"
      ],
      "category": "calculation",
      "description": "单回路三根相同无铠装单芯电缆，均匀土壤、恒温地表。；交流附加系数与屏蔽损耗系数为输入假设，不自动计算集肤、邻近或护套环流。",
      "parameter_schema": {
        "type": "object",
        "properties": {
          "conductor_kind": {
            "default": "copper",
            "enum": [
              "copper",
              "aluminium"
            ],
            "title": "导体材料",
            "type": "string",
            "description": "选择模型支持的铜或铝导体，与型号材料事实一致。",
            "x-unit": {
              "si": null,
              "display": null,
              "scale": 1,
              "offset": 0
            },
            "x-group": "physics",
            "x-order": 0,
            "x-level": "basic",
            "x-default-basis": {
              "kind": "engineering",
              "reference": "plugins/cablesim.thermal-network/src 的 steady-rating 输入校验；契约适用范围与显式工程输入；物理取值须附资料来源，不代表通用标准限值。"
            },
            "x-range-basis": {
              "kind": "engineering",
              "reference": "plugins/cablesim.thermal-network/src 的 steady-rating 输入校验；契约适用范围与显式工程输入；物理取值须附资料来源，不代表通用标准限值。"
            }
          },
          "ac_extra_factor": {
            "default": 0.05,
            "maximum": 1,
            "minimum": 0,
            "title": "交流附加损耗系数",
            "type": "number",
            "description": "导体交流电阻相对直流电阻的附加比例，采用有来源的电损耗计算结果。",
            "x-unit": {
              "si": "1",
              "display": "1",
              "scale": 1,
              "offset": 0
            },
            "x-group": "physics",
            "x-order": 1,
            "x-level": "basic",
            "x-default-basis": {
              "kind": "engineering",
              "reference": "plugins/cablesim.thermal-network/src 的 steady-rating 输入校验；契约适用范围与显式工程输入；物理取值须附资料来源，不代表通用标准限值。"
            },
            "x-range-basis": {
              "kind": "engineering",
              "reference": "plugins/cablesim.thermal-network/src 的 steady-rating 输入校验；契约适用范围与显式工程输入；物理取值须附资料来源，不代表通用标准限值。"
            }
          },
          "screen_loss_factor": {
            "default": 0.05,
            "maximum": 2,
            "minimum": 0,
            "title": "屏蔽损耗系数",
            "type": "number",
            "description": "屏蔽损耗与导体损耗之比，须有接地方式及温度适用依据。",
            "x-unit": {
              "si": "1",
              "display": "1",
              "scale": 1,
              "offset": 0
            },
            "x-group": "physics",
            "x-order": 2,
            "x-level": "basic",
            "x-default-basis": {
              "kind": "engineering",
              "reference": "plugins/cablesim.thermal-network/src 的 steady-rating 输入校验；契约适用范围与显式工程输入；物理取值须附资料来源，不代表通用标准限值。"
            },
            "x-range-basis": {
              "kind": "engineering",
              "reference": "plugins/cablesim.thermal-network/src 的 steady-rating 输入校验；契约适用范围与显式工程输入；物理取值须附资料来源，不代表通用标准限值。"
            }
          },
          "target_current_a": {
            "type": "number",
            "exclusiveMinimum": 0,
            "title": "校核目标电流",
            "description": "用于余量或允许运行判断的研究目标电流，缺省沿用保存负荷。",
            "x-unit": {
              "si": "A",
              "display": "A",
              "scale": 1,
              "offset": 0
            },
            "x-group": "operating",
            "x-order": 3,
            "x-level": "basic",
            "x-range-basis": {
              "kind": "engineering",
              "reference": "plugins/cablesim.thermal-network/src 的 steady-rating 输入校验；契约适用范围与显式工程输入；物理取值须附资料来源，不代表通用标准限值。"
            }
          },
          "fill_factor": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1,
            "readOnly": true,
            "title": "导体填充率",
            "description": "领域模型导体标称面积与外径面积之比，由领域几何绑定；兼容迁移记录中的旧值，计算时仍从几何重新取得。",
            "x-unit": {
              "si": "1",
              "display": "1",
              "scale": 1,
              "offset": 0
            },
            "x-group": "model",
            "x-order": 5,
            "x-level": "expert",
            "x-bind": {
              "type": "cable_type",
              "scope": "workspace",
              "read_only": true
            },
            "x-range-basis": {
              "kind": "binding",
              "reference": "domain.py:46 从保存导体面积及外径取得；迁移记录值不覆盖几何事实。"
            }
          },
          "include_field": {
            "type": "boolean",
            "default": false,
            "title": "输出热路场视图",
            "description": "生成当前热网络支持的参考温度视图，不能声明为收敛有限元。",
            "x-unit": {
              "si": null,
              "display": null,
              "scale": 1,
              "offset": 0
            },
            "x-group": "physics",
            "x-order": 4,
            "x-level": "advanced",
            "x-default-basis": {
              "kind": "engineering",
              "reference": "plugins/cablesim.thermal-network/src 的 steady-rating 输入校验；契约适用范围与显式工程输入；物理取值须附资料来源，不代表通用标准限值。"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "conductor_kind",
          "ac_extra_factor",
          "screen_loss_factor"
        ]
      },
      "x-groups": [
        {
          "id": "model",
          "title": "模型与对象",
          "order": 0
        },
        {
          "id": "operating",
          "title": "工况与目标",
          "order": 1
        },
        {
          "id": "materials",
          "title": "材料与构造",
          "order": 2
        },
        {
          "id": "physics",
          "title": "物理方法",
          "order": 3
        },
        {
          "id": "numerical",
          "title": "数值与离散",
          "order": 4
        },
        {
          "id": "evidence",
          "title": "来源与证据",
          "order": 5
        }
      ],
      "input_contract": {
        "input_sources": [
          "domain",
          "study"
        ],
        "binding": {
          "type": "domain",
          "scope": "workspace",
          "read_only": true
        }
      },
      "preview": true,
      "preview_timeout_s": 8,
      "x-headline": [
        {
          "key": "ampacity",
          "title": "允许电流",
          "unit": {
            "si": "A",
            "display": "A",
            "scale": 1,
            "offset": 0
          },
          "aggregate": "minimum",
          "artifact": "x-cablesim.headline-witness",
          "source_artifact": "x-cablesim.thermal-network-rating"
        },
        {
          "key": "conductor_temperature",
          "title": "最高导体温度",
          "unit": {
            "si": "K",
            "display": "°C",
            "scale": 1,
            "offset": -273.15
          },
          "aggregate": "maximum",
          "artifact": "x-cablesim.headline-witness",
          "source_artifact": "x-cablesim.thermal-network-rating"
        }
      ],
      "study_tasks": []
    }
  ],
