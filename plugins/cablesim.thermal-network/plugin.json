{
  "schema": "cablesim.plugin/2",
  "id": "cablesim.thermal-network",
  "version": "1.1.1",
  "name": "热网络参考",
  "description": "用简化热网络估算载流量与运行温度，提供竖向和场分析参考；不替代 IEC 60287 方法。",
  "icon": "assets/icon.svg",
  "publisher": {
    "id": "cablesim",
    "name": "CableSimPro"
  },
  "host_api": {
    "major": 2,
    "min_minor": 1
  },
  "license": {
    "spdx": "LicenseRef-Project-Undeclared",
    "review_required": false
  },
  "platforms": [
    "windows-x64",
    "linux-x64",
    "darwin-arm64",
    "darwin-x64"
  ],
  "runtime": {
    "kind": "python",
    "python": ">=3.11,<3.14",
    "entry": "src/cablesim_thermal_network/main.py"
  },
  "permissions": [
    "study.run",
    "artifact.write"
  ],
  "dependencies": [],
  "resources": {
    "timeout_s": 60,
    "memory_mb": 512,
    "network": "none"
  },
  "capabilities": [
    {
      "kind": "method",
      "id": "steady-rating",
      "title": "直埋稳态载流量与运行温度（简化热网络）",
      "method_version": "MV-THERMAL-0.1.0",
      "analysis": "steady_state",
      "input_schema": "cablesim.scenario/1",
      "outputs": [
        {
          "key": "ampacity",
          "type": "quantity",
          "per": "circuit",
          "required": true
        },
        {
          "key": "conductor_temperature",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "losses.dielectric",
          "type": "quantity",
          "per": "cable",
          "required": false
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.thermal-network-rating",
          "required": true
        }
      ],
      "validation": {
        "level": "unverified",
        "cases": []
      },
      "limitations": [
        "单回路三根相同无铠装单芯电缆，均匀土壤、恒温地表。",
        "交流附加系数与屏蔽损耗系数为输入假设，不自动计算集肤、邻近或护套环流。",
        "不是完整 IEC 60287 实现；经 TB 880 验证的方法见 cablesim.iec60287。"
      ]
    },
    {
      "kind": "method",
      "id": "network-properties",
      "title": "热网络几何、热阻与损耗属性",
      "method_version": "MV-THERMAL-0.1.0",
      "analysis": "properties",
      "input_schema": "cablesim.scenario/1",
      "outputs": [
        {
          "key": "losses.dielectric",
          "type": "quantity",
          "per": "cable",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.thermal-network-properties",
          "required": true
        }
      ],
      "validation": {
        "level": "unverified",
        "cases": []
      },
      "limitations": [
        "热网络属性兼容接口，不是独立的工程验证方法。"
      ]
    },
    {
      "kind": "method",
      "id": "vertical-rating",
      "title": "单根竖向空气参考",
      "method_version": "VERTICAL-FV-0.4.1",
      "analysis": "steady_state",
      "input_schema": "cablesim.scenario/1",
      "outputs": [
        {
          "key": "ampacity",
          "type": "quantity",
          "per": "circuit",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.vertical",
          "required": true
        }
      ],
      "validation": {
        "level": "analytic-benchmark",
        "cases": [
          "uniform-air-closed-form",
          "axial-energy-balance"
        ]
      },
      "limitations": [
        "单根隔离电缆、给定换热系数，不求解井道气流或成束互热。"
      ]
    },
    {
      "kind": "method",
      "id": "field-analysis",
      "title": "截面场参考",
      "method_version": "CABLE-FIELDS-0.4.0",
      "analysis": "field",
      "input_schema": "cablesim.scenario/1",
      "outputs": [
        {
          "key": "x-cablesim.field-maximum",
          "type": "quantity",
          "per": "circuit",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.field",
          "required": true
        }
      ],
      "validation": {
        "level": "analytic-benchmark",
        "cases": [
          "poisson-manufactured-solution",
          "coaxial-voltage-integral"
        ]
      },
      "limitations": [
        "限定范围的外部土壤有限差分与同轴电场、无限长导体磁场，不是全耦合 FEM。"
      ]
    }
  ],
