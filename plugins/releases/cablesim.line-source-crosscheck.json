  "commands": [
    {
      "id": "validation.line-source-buried",
      "title": "核对半空间线热源解析温升",
      "effect": "artifact",
      "input_contract": "LineSourceArgs",
      "output_contract": "cablesim.line-source-crosscheck/1",
      "ui_slot": "results"
    }
  ],
  "scope": {
    "description": "自动绑定本项目当前版本最新成功的三相定功率直埋 FEM 摘要，用恒温地表半空间线热源 Green 函数和六层同心圆柱热阻独立计算导体中心温度并报告差异。",
    "limitations": [
      "只接受当前工程版本最新成功的 cablesim.buried-reference 工件；结果中记录准确来源任务，不比较电热反馈或允许电流。",
      "解析模型没有 FEM 的有限侧面/底部边界，也不表示电缆有限半径的完整外场解。",
      "差异混合了计算域截断、线源近似、网格与多边形几何误差；没有预设通过阈值。",
      "不是试验验证、完整 IEC 60287 实现、认证或工程验收。"
    ],
    "validation": "contract-tests",
    "evidence": [
      "tests/plugins/test_line_source_contract.py",
      "plugin-tests/test_line_source.py"
    ]
  },
