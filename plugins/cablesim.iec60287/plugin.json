{
  "schema": "cablesim.plugin/2",
  "id": "cablesim.iec60287",
  "version": "0.4.0",
  "name": "IEC 60287 载流量",
  "description": "计算多回路单芯直埋、排管与矩形回填的稳态温度和允许电流，输出逐电缆互热贡献与核对表。",
  "icon": "assets/icon.svg",
  "publisher": {
    "id": "cablesim",
    "name": "CableSimPro"
  },
  "host_api": {
    "major": 2,
    "min_minor": 1
  },
  "license": {
    "spdx": "LicenseRef-Project-Undeclared",
    "review_required": false
  },
  "platforms": [
    "windows-x64",
    "linux-x64",
    "darwin-arm64",
    "darwin-x64"
  ],
  "runtime": {
    "kind": "python",
    "python": ">=3.11,<3.14",
    "entry": "src/cablesim_iec60287/main.py"
  },
  "permissions": [
    "study.run",
    "artifact.write"
  ],
  "dependencies": [],
  "resources": {
    "timeout_s": 60,
    "memory_mb": 256,
    "network": "none"
  },
  "capabilities": [
    {
      "kind": "method",
      "id": "steady-rating",
      "title": "地下稳态（IEC 60287-1-1 / 2-1:2023，多回路直埋 / 排管 / 矩形回填）",
      "method_version": "cablesim.iec60287.group/0.3.0",
      "analysis": "steady_state",
      "input_schema": "cablesim.domain/1",
      "outputs": [
        {
          "key": "ampacity",
          "type": "quantity",
          "per": "circuit",
          "required": true
        },
        {
          "key": "conductor_temperature",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "sheath_temperature",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "surface_temperature",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "losses.conductor",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "losses.sheath",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "losses.dielectric",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "losses.total",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "loss_factor.sheath",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
