          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "capacitance",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "thermal_resistance.insulation",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "thermal_resistance.oversheath",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "thermal_resistance.external",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "x-cablesim.iec60287.thermal_resistance.duct_air",
          "type": "quantity",
          "per": "cable",
          "required": false
        },
        {
          "key": "x-cablesim.iec60287.thermal_resistance.duct_wall",
          "type": "quantity",
          "per": "cable",
          "required": false
        },
        {
          "key": "x-cablesim.iec60287.temperature_rise.mutual",
          "type": "quantity",
          "per": "cable",
          "required": false
        },
        {
          "key": "x-cablesim.iec60287.current",
          "type": "quantity",
          "per": "cable",
          "required": false
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.iec60287-trace",
          "required": true
        }
      ],
      "validation": {
        "level": "reference-benchmark",
        "cases": [
          "CIGRE TB 880 Case 0-1",
          "CIGRE TB 880 Case 0-1 exact radical T4",
          "CIGRE TB 880 Case 0-1 single-point bonding",
          "CIGRE TB 880 Case 0-1 GP31 eddy",
          "CIGRE TB 880 Case 0-2",
          "CIGRE TB 880 Case 0-2 GP31 eddy",
          "CIGRE TB 880 Case 0-3 flat duct bank",
          "CIGRE TB 880 Case 0-3 single-point bonding",
          "CIGRE TB 880 Case 0-3 GP31 eddy",
          "IEC 2023 image-source analytic two-cable and unequal N-source checks",
          "IEC 2023 Table 2 nodes, interpolation and unequal backfill correction",
          "Nine layout templates: independent logarithmic heat-balance and frozen-loss quadratic checks"
        ]
      },
      "limitations": [
        "地下稳态、恒温地表、均匀原土或单一矩形回填区；不支持分层土壤、多介质分区或土壤干燥。",
        "任意 N 不接触热源；自动电损耗仅适用于完整平衡三相单回路、等间距品字形或水平。多回路、任意排列或不平衡三相须提供逐电缆损耗系数及来源。",
        "独立多回路不套用单回路电损耗公式；当前仅以外部提供的损耗系数求热平衡，系数必须覆盖计算电流范围。未实现通用跨回路电磁求解器。",
        "单回路接触品字形采用标准等效组热阻；其他接触组合明确拒算。排管每根一管、同心、电缆外径 25–100 mm。",
        "逐回路允许电流保持其他回路保存负荷，各回路上限不可同时使用。",
        "无铠装、不计土壤干燥与外部热源；仅光滑管状金属护套；不支持交叉互联。",
        "ks、kp 及管道常数 U、V、Y 须显式给定；工程计算使用 2023 表 2，范围外或无法核实的节点拒算。水平护套涡流按 1-1:2023 5.3.7.1(2)，已用 TB 880 单点接地与两端接地变体验证。",
        "reference_basis=tb880_reference 仅复现 TB 880 所用旧版电容、等效回填半径和接触品字形热阻约定，结果标为参考复现，不能作为 IEC 2023 工程结论。",
        "验证夹具来自受控资料，不随公开仓库分发；验证只覆盖所列算例与分支，不构成合规认证。"
      ]
    }
  ],
