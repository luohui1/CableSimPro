{
  "schema": "cablesim.plugin/2",
  "id": "cablesim.iec60287",
  "version": "0.2.4",
  "name": "IEC 60287 载流量",
  "description": "计算单芯接触品字形电缆直埋或排管的稳态载流量，输出损耗、热阻与计算依据。",
  "icon": "assets/icon.svg",
  "publisher": {
    "id": "cablesim",
    "name": "CableSimPro"
  },
  "host_api": {
    "major": 2,
    "min_minor": 1
  },
  "license": {
    "spdx": "LicenseRef-Project-Undeclared",
    "review_required": false
  },
  "platforms": [
    "windows-x64",
    "linux-x64",
    "darwin-arm64",
    "darwin-x64"
  ],
  "runtime": {
    "kind": "python",
    "python": ">=3.11,<3.14",
    "entry": "src/cablesim_iec60287/main.py"
  },
  "permissions": [
    "study.run",
    "artifact.write"
  ],
  "dependencies": [],
  "resources": {
    "timeout_s": 60,
    "memory_mb": 256,
    "network": "none"
  },
  "capabilities": [
    {
      "kind": "method",
      "id": "steady-rating",
      "title": "稳态载流量（IEC 60287-1-1 / 2-1:2023，单芯接触品字形）",
      "method_version": "cablesim.iec60287.single-core-trefoil-buried/0.1.0",
      "analysis": "steady_state",
      "input_schema": "cablesim.iec60287.single-core/1",
      "outputs": [
        {
          "key": "ampacity",
          "type": "quantity",
          "per": "circuit",
          "required": true
        },
        {
          "key": "conductor_temperature",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "sheath_temperature",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "surface_temperature",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "losses.conductor",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "losses.sheath",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "losses.dielectric",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "losses.total",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "loss_factor.sheath",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "ac_resistance",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "capacitance",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "thermal_resistance.insulation",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "thermal_resistance.oversheath",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "thermal_resistance.external",
          "type": "quantity",
          "per": "cable",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.iec60287-trace",
          "required": true
        }
      ],
      "validation": {
        "level": "reference-benchmark",
        "cases": [
          "CIGRE TB 880 Case 0-1",
          "CIGRE TB 880 Case 0-1 exact radical T4",
          "CIGRE TB 880 Case 0-1 single-point bonding",
          "CIGRE TB 880 Case 0-1 GP31 eddy",
          "CIGRE TB 880 Case 0-2",
          "CIGRE TB 880 Case 0-2 GP31 eddy"
        ]
      },
      "limitations": [
        "仅三根等负荷单芯电缆接触品字形排列；均匀土壤、恒温地表、100 % 负荷率。",
        "无铠装、不计土壤干燥与外部热源；仅光滑管状金属护套；不支持交叉互联。",
        "ks、kp 及管道常数 U、V、Y 由使用者按标准表给定；本插件不内置标准表。",
        "验证夹具来自受控资料，不随公开仓库分发；验证只覆盖所列算例与分支，不构成合规认证。"
      ]
    }
