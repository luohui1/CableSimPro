{
  "schema": "cablesim.plugin/2",
  "id": "cablesim.hybrid-rating",
  "version": "0.1.0",
  "name": "混合载流量研究",
  "description": "IEC物理基线与有限元热场修正，带适用域、预测区间及训练来源；默认仅参考。",
  "icon": "assets/icon.svg",
  "publisher": {
    "id": "cablesim",
    "name": "CableSimPro"
  },
  "host_api": {
    "major": 2,
    "min_minor": 1
  },
  "license": {
    "spdx": "LicenseRef-Project-Undeclared",
    "review_required": true
  },
  "platforms": [
    "windows-x64",
    "linux-x64"
  ],
  "runtime": {
    "kind": "python",
    "python": ">=3.11,<3.14",
    "entry": "src/cablesim_hybrid_rating/main.py"
  },
  "permissions": [
    "project.read",
    "study.run",
    "artifact.write"
  ],
  "dependencies": [],
  "resources": {
    "timeout_s": 3600,
    "memory_mb": 4096,
    "network": "none"
  },
  "capabilities": [
    {
      "kind": "method",
      "id": "training-sample",
      "title": "收敛有限元与IEC配对样本",
      "method_version": "hybrid-label/0.1.0",
      "analysis": "steady_state",
      "input_schema": "cablesim.domain/1",
      "outputs": [
        {
          "key": "ampacity",
          "type": "quantity",
          "per": "circuit",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.dataset-sample",
          "required": true
        }
      ],
      "validation": {
        "level": "unverified",
        "cases": []
      },
      "limitations": [
        "仅Slurm；三档网格收敛；仅参考。",
        "热场模式冻结IEC电损耗；显式选择电磁热模式时由GetDP逐工作点重算sigma(T)、邻近效应及护套损耗。",
        "分层模型训练使用明确标记的均匀土壤IEC对照，另附同条件两层解析参照；默认仅参考。"
      ]
    },
    {
      "kind": "method",
      "id": "train-model",
      "title": "CPU训练与独立留出验证",
      "method_version": "hybrid-training/0.1.0",
      "analysis": "steady_state",
      "input_schema": "cablesim.hybrid-training/1",
      "outputs": [
        {
          "key": "x-cablesim.training-samples",
          "type": "quantity",
          "per": "section",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.hybrid-model",
          "required": true
        }
      ],
      "validation": {
        "level": "unverified",
        "cases": []
      },
      "limitations": [
        "仅Slurm CPU；只使用收敛配对标签；不读取任意文件或pickle。",
        "仿真验证不等于独立实测验证，禁止自动工程批准。"
      ]
    },
    {
      "kind": "method",
      "id": "steady-rating",
      "title": "IEC基线加有限元数据修正",
      "method_version": "hybrid-rating/0.1.0",
      "analysis": "steady_state",
      "input_schema": "cablesim.domain/1",
      "outputs": [
        {
          "key": "ampacity",
          "type": "quantity",
          "per": "circuit",
          "required": true
        },
        {
          "key": "conductor_temperature",
          "type": "quantity",
          "per": "circuit",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.hybrid-prediction",
          "required": true
        }
      ],
      "validation": {
        "level": "unverified",
        "cases": []
      },
      "limitations": [
        "只接受已登记的准确模型哈希；训练域外拒绝。",
        "默认reference_only；区间为95%校准预测区间，未代表实测工程保证。"
      ]
    },
    {
      "kind": "method",
      "id": "physics-comparison",
      "title": "标准与有限元物理对比",
      "method_version": "hybrid-physics-comparison/0.1.0",
      "analysis": "steady_state",
      "input_schema": "cablesim.domain/1",
      "outputs": [
        {
          "key": "ampacity",
          "type": "quantity",
          "per": "circuit",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.physics-comparison",
          "required": true
        }
      ],
      "validation": {
        "level": "unverified",
        "cases": []
      },
      "limitations": [
        "仅Slurm求解；温度和允许电流通过三档网格及能量门禁后才显示。",
        "分层工况IEC列为均匀土壤对照；实际分层解析参照单独显示，不自动批准工程使用。"
      ]
    }
  ],
