{
  "schema": "cablesim.plugin/2",
  "id": "cablesim.simulation",
  "version": "0.4.0",
  "name": "仿真复现基准",
  "description": "多区域稳态导热与GetDP时谐涡流、Elmer稳态/瞬态热适配，使用统一问题、网格和复现工件。",
  "icon": "assets/icon.svg",
  "publisher": {
    "id": "cablesim",
    "name": "CableSimPro"
  },
  "host_api": {
    "major": 2,
    "min_minor": 1
  },
  "license": {
    "spdx": "LicenseRef-Project-Undeclared",
    "review_required": true
  },
  "platforms": [
    "windows-x64",
    "linux-x64"
  ],
  "runtime": {
    "kind": "python",
    "python": ">=3.11,<3.14",
    "entry": "src/cablesim_simulation/main.py"
  },
  "permissions": [
    "project.read",
    "study.run",
    "artifact.write"
  ],
  "dependencies": [],
  "resources": {
    "timeout_s": 3600,
    "memory_mb": 4096,
    "network": "none"
  },
  "capabilities": [
    {
      "kind": "method",
      "id": "transient-temperature",
      "title": "研究截面与负荷曲线暂态温升",
      "method_version": "transient-temperature/0.1.0",
      "analysis": "transient",
      "input_schema": "cablesim.domain/1",
      "outputs": [
        {
          "key": "conductor_temperature",
          "type": "quantity",
          "per": "cable",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.simulation-bundle",
          "required": true
        },
        {
          "type": "x-cablesim.temperature-history",
          "required": true
        },
        {
          "type": "x-cablesim.temperature-field",
          "required": true
        }
      ],
      "validation": {
        "level": "analytic-benchmark",
        "cases": [
          "plugin-tests/test_research_simulation.py: homogeneous cylinder Bessel step superposition; every time step; field and source binding",
          "plugin-tests/test_transient_history.py: independent slab Fourier solution"
        ]
      },
      "limitations": [
        "仅在 Slurm 执行；显式均匀初温和逐区体积热容，阶跃/周期/应急负荷。",
        "恒定热物性与声明温度下冻结电阻；暂态不含 R(T) 双向反馈、辐射、隐式预负荷或初始场。",
        "温限时刻由真实时间步线性插值并保存区间；不外推。单次求解不自动证明网格/时间步收敛。"
      ]
    },
    {
      "kind": "method",
      "id": "sheath-losses",
      "title": "研究接地拓扑与护套损耗",
      "method_version": "sheath-losses/0.1.0",
      "analysis": "frequency_domain",
      "input_schema": "cablesim.domain/1",
      "outputs": [
        {
          "key": "x-cablesim.sheath-loss",
          "type": "quantity",
          "per": "cable",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.simulation-bundle",
          "required": true
        },
        {
          "type": "x-cablesim.loss-coefficients",
          "required": true
        },
        {
          "type": "x-cablesim.sheath-losses",
          "required": true
        }
      ],
      "validation": {
        "level": "reference-benchmark",
        "cases": [
          "plugin-tests/test_research_simulation.py: native GetDP topology, independent Faraday/Kirchhoff hand circuit, and saved temperature-table reference consumed by IEC",
          "plugin-tests/test_reproduction_regressions.py: public GetDP electromagnetic benchmarks"
        ]
      },
      "limitations": [
        "仅在 Slurm 执行；完整三相单芯实心圆导体、明确光滑层、保存的相序与接地来源。",
        "交叉互联为三个独立二维场切片加 GetDP 原生电路，记录实际小段电压长度；不含弯曲三维效应或大地回流。",
        "固定点外部 λ1 不可供 IEC 变温迭代；单截面完整温度张量并通过独立中心点验证后才允许声明范围内迭代。"
      ]
    },
    {
      "kind": "method",
      "id": "electrothermal-steady",
      "title": "研究截面双向稳态电热耦合",
      "method_version": "electrothermal-steady/0.1.0",
      "analysis": "steady_state",
      "input_schema": "cablesim.domain/1",
      "outputs": [
        {
          "key": "x-cablesim.maximum-temperature",
          "type": "quantity",
          "per": "section",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.simulation-bundle",
          "required": true
        },
        {
          "type": "x-cablesim.temperature-field",
          "required": true
        }
      ],
      "validation": {
        "level": "reference-benchmark",
        "cases": [
          "plugin-tests/test_research_simulation.py: saved-domain GetDP/P1 feedback and independent coaxial I-squared-R(T) hand verification; temperature/power/energy criteria",
          "plugin-tests/test_simulation_coupled.py: independent coaxial analytic and COMSOL checks"
        ]
      },
      "limitations": [
        "仅在 Slurm 执行；单截面 GetDP σ(T) 与 P1 导热双向反馈，保存逐轮温度/功率/能量残差。",
        "明确热导率、材料有效温区和环境温度；单点或两端接地，不含三小段电热反馈、暂态、辐射和接触热阻。",
        "磁准静态焦耳/磁性损耗与恒定热导率模型，不替代完整 IEC 载流量或工程批准。"
      ]
    },
    {
      "kind": "method",
      "id": "thermal-dataset",
      "title": "稳态热场与允许电流数据样本",
      "method_version": "thermal-dataset/0.1.0",
      "analysis": "steady_state",
      "input_schema": "cablesim.thermal-model/1",
      "outputs": [
        {
          "key": "conductor_temperature",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "ampacity",
          "type": "quantity",
          "per": "circuit",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.dataset-sample",
          "required": true
        }
      ],
      "validation": {
        "level": "reference-benchmark",
        "cases": [
          "radial heat and resistive current hand solution; mesh refinement; same input on local and Slurm"
        ]
      },
      "limitations": [
        "计算范围继承多区域二维热场；显式保存运行点、指定回路额定电流、三档以上网格和收敛判定。",
        "其他回路保持保存负荷；未做计算域敏感性或物理模型认证；未收敛样本保留但不进入有效标签。"
      ]
    },
    {
      "kind": "method",
      "id": "contact-electrothermal-field",
      "title": "完整接触热域双向电热耦合",
      "method_version": "contact-electrothermal-field/0.1.0",
      "analysis": "steady_state",
      "input_schema": "cablesim.contact-electrothermal-field/1",
      "outputs": [
        {
          "key": "x-cablesim.maximum-temperature",
          "type": "quantity",
          "per": "section",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.simulation-bundle",
          "required": true
        },
        {
          "type": "x-cablesim.temperature-field",
          "required": true
        }
      ],
      "validation": {
        "level": "reference-benchmark",
        "cases": [
          "COMSOL06 independent Gmsh full geometry and bidirectional GetDP/contact thermal feedback"
        ]
      },
      "limitations": [
        "显式SI网格、温变电阻率和热导率、内部接触热阻及等幅给定电流源；外磁边界A=0，热外边界给定温度。",
        "均质绕组的平均端口Rac(T)必须有来源，含无源区域损耗；不外推材料温区，不替代IEC公式或真实三维绞合。"
      ]
    },
    {
      "kind": "method",
      "id": "terminal-field",
      "title": "多端子三相截面电容场",
      "method_version": "terminal-field/0.1.0",
      "analysis": "frequency_domain",
      "input_schema": "cablesim.terminal-field/1",
      "outputs": [
        {
          "key": "x-cablesim.terminal-capacitance",
          "type": "quantity",
          "per": "cable",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.simulation-bundle",
          "required": true
        }
      ],
      "validation": {
        "level": "reference-benchmark",
        "cases": [
          "Parallel-plate complex admittance; COMSOL02 six-terminal full geometry; tests/test_triangular_fields.py"
        ]
      },
      "limitations": [
        "显式来源的SI三角网格、各向同性sigma/epsilon、等电势端子和接地边界；P1复电势场。",
        "输出完整单位长度Y/C矩阵；不含磁感应与三维端部。网格生成来源须单独注明。"
      ]
    },
    {
      "kind": "method",
      "id": "contact-thermal-field",
      "title": "完整热域与薄层接触热阻",
      "method_version": "contact-thermal-field/0.1.0",
      "analysis": "steady_state",
      "input_schema": "cablesim.contact-thermal-field/1",
      "outputs": [
        {
          "key": "x-cablesim.maximum-temperature",
          "type": "quantity",
          "per": "section",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.simulation-bundle",
          "required": true
        },
        {
          "type": "x-cablesim.temperature-field",
          "required": true
        }
      ],
      "validation": {
        "level": "reference-benchmark",
        "cases": [
          "Two-slab temperature jump and heat balance; COMSOL06 full thermal geometry; tests/test_triangular_fields.py"
        ]
      },
      "limitations": [
        "显式来源的SI三角网格与体热源、有限温区k(T)多项式、给定温度外边界及内部零厚度接触热阻；不收敛或越界拒绝。",
        "不含暂态、对流流场、接触层面内传热或双向电磁热耦合；接触界面两侧温度独立导出。"
      ]
    },
    {
      "kind": "method",
      "id": "electrothermal",
      "title": "GetDP 电磁与温度场耦合",
      "method_version": "electrothermal/0.1.0",
      "analysis": "steady_state",
      "input_schema": "cablesim.electrothermal/1",
      "outputs": [
        {
          "key": "x-cablesim.maximum-temperature",
          "type": "quantity",
          "per": "section",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.simulation-bundle",
          "required": true
        },
        {
          "type": "x-cablesim.temperature-field",
          "required": true
        }
      ],
      "validation": {
        "level": "reference-benchmark",
        "cases": [
          "Coaxial sigma(T) feedback versus native COMSOL FrequencyStationary; plugin-tests/test_simulation_coupled.py"
        ]
      },
      "limitations": [
        "二维P1磁准静态与稳态导热；点式sigma(T)，固定k/mu，必须给出全部导电材料的温度有效区间。",
        "不含薄层接触热阻、暂态、介电热源、端部和完整COMSOL06多区域模型；不收敛或越界明确拒绝。"
      ]
    },
    {
      "kind": "method",
      "id": "capacitive-cable",
      "title": "同轴电缆频域电流与电容效应",
      "method_version": "capacitive-cable/0.1.0",
      "analysis": "frequency_domain",
      "input_schema": "cablesim.capacitive-cable/1",
      "outputs": [
        {
          "key": "x-cablesim.dielectric-screen-loss",
          "type": "quantity",
          "per": "cable",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.simulation-bundle",
          "required": true
        }
      ],
      "validation": {
        "level": "reference-benchmark",
        "cases": [
          "COMSOL submarine02 radial capacitance submodel and submarine03 axisymmetric bonding; plugin-tests/test_simulation_capacitive.py"
        ]
      },
      "limitations": [
        "同轴层状轴对称P1频域电流场，显式sigma/epsilon及峰值相量；含单点、两端和三段交叉互联，护套连续。",
        "不包含三相截面互电容、磁感应或铠装；COMSOL03的各向异性数值材料需显式输入，不冒充各向同性实物。"
      ]
    },
    {
      "kind": "method",
      "id": "getdp-eddy",
      "title": "GetDP 二维时谐涡流",
      "method_version": "getdp-eddy/0.1.0",
      "analysis": "frequency_domain",
      "input_schema": "cablesim.simulation-problem/1",
      "outputs": [
        {
          "key": "x-cablesim.joule-loss",
          "type": "quantity",
          "per": "cable",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.simulation-bundle",
          "required": true
        },
        {
          "type": "x-cablesim.reproduction-report",
          "required": true
        },
        {
          "type": "x-cablesim.loss-coefficients",
          "required": false
        }
      ],
      "validation": {
        "level": "reference-benchmark",
        "cases": [
          "E05平排护套GetDP场路联立；E17双线电阻；E18被动导体表面涡流；V01圆柱Bessel校核；见docs/plugins/SIMULATION.md与plugin-tests/test_simulation_external.py"
        ]
      },
      "limitations": [
        "需要独立安装GetDP3.5.0；启动前检测，缺失或版本不符明确失败。外部程序不随插件分发。",
        "二维无限长磁准静态Az-u联立，RMS相量、恒定各向同性sigma/mu，显式区域电流/电压和理想浮置互联组；无位移电流、铁磁非线性、端部或接地电阻网络。",
        "领域映射仅实心圆单芯及明确光滑同心层；参数更复杂时使用完整问题描述；有限外边界须单独核验域收敛。"
      ]
    },
    {
      "kind": "method",
      "id": "elmer-heat",
      "title": "Elmer 稳态与瞬态热场",
      "method_version": "elmer-heat/0.1.0",
      "analysis": "transient",
      "input_schema": "cablesim.simulation-problem/1",
      "outputs": [
        {
          "key": "x-cablesim.maximum-temperature",
          "type": "quantity",
          "per": "section",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.simulation-bundle",
