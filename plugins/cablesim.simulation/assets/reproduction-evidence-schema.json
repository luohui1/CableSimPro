{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saved reproduction evidence snapshot",
  "type": "object",
  "required": ["schema", "created_at", "items"],
  "properties": {
    "schema": {"const": "cablesim.reproduction-library/1"},
    "created_at": {"type": "string", "minLength": 1},
    "counting_rule": {"type": "string"},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "title", "kind", "status", "rows", "limitations", "inputs", "convergence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "kind": {"enum": ["paper", "standard", "comsol", "benchmark"]},
          "status": {"enum": ["reproduced", "partial", "missing_data", "capability_gap"]},
          "rows": {"type": "array", "items": {"type": "object"}},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "inputs": {"type": "array", "items": {"type": "object"}},
          "convergence": {"type": "array", "items": {"type": "object"}},
          "sensitivity": {
            "type": "object", "required": ["schema", "classification", "rows", "source_pages", "source_sha256", "job_ids"],
            "properties": {
              "schema": {"const": "cablesim.tb880-sensitivity/1"},
              "classification": {"enum": ["basis_difference", "not_resolved"]},
              "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "source_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
              "job_ids": {"type": "array", "items": {"type": "string"}},
              "rows": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "required": ["id", "label", "status", "ampacity_a", "delta_a", "delta_percent"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "label": {"type": "string", "minLength": 1},
                    "status": {"enum": ["complete", "failed"]},
                    "ampacity_a": {"type": ["number", "null"]},
                    "delta_a": {"type": ["number", "null"]},
                    "delta_percent": {"type": ["number", "null"]}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
