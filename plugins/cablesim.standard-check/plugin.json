{
  "schema": "cablesim.plugin/2",
  "id": "cablesim.standard-check",
  "version": "1.0.3",
  "name": "产品标准尺寸核对",
  "icon": "assets/icon.svg",
  "presentation": {
    "category": "data-standard",
    "category_title": "数据与标准",
    "assets": [
      {
        "role": "cover",
        "path": "assets/cover.webp",
        "title": "产品标准尺寸核对封面",
        "description": "仓库既有插件封面，随发行包封签。",
        "media_type": "image/webp"
      },
      {
        "role": "method",
        "path": "assets/method.svg",
        "title": "产品标准尺寸核对方法示意",
        "description": "按实际模型手工绘制的示意图；不包含虚构结果。",
        "media_type": "image/svg+xml"
      }
    ],
    "validation_note": "无参考算例可发布数值数据；已声明的源码测试与适用范围见各能力validation，不据此生成验证图。"
  },
  "description": "按已核验 GB 产品标准核对结构尺寸和导体 R₂₀，逐条记录条款、余量、数据缺项与未覆盖范围。",
  "publisher": {
    "id": "cablesim",
    "name": "CableSimPro"
  },
  "host_api": {
    "major": 2,
    "min_minor": 1
  },
  "license": {
    "spdx": "LicenseRef-Project-Undeclared",
    "review_required": false
  },
  "platforms": [
    "windows-x64",
    "linux-x64",
    "darwin-arm64",
    "darwin-x64"
  ],
  "runtime": {
    "kind": "python",
    "python": ">=3.11,<3.14",
    "entry": "src/cablesim_standard_check/main.py"
  },
  "permissions": [
    "study.run",
    "artifact.write"
  ],
  "dependencies": [],
  "resources": {
    "timeout_s": 10,
    "memory_mb": 128,
    "network": "none"
  },
  "capabilities": [
    {
      "kind": "method",
      "id": "dimensions",
      "title": "GB 产品标准结构尺寸与电阻核对",
      "method_version": "1.0.0",
      "analysis": "standard_check",
      "input_schema": "cablesim.domain/1",
      "outputs": [
        {
          "key": "x-cablesim.standard-failed-count",
          "type": "quantity",
          "per": "cable",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.standard-check",
          "required": true
        },
        {
          "type": "x-cablesim.headline-witness",
          "required": false
        }
      ],
      "validation": {
        "level": "unverified",
        "cases": []
      },
      "limitations": [
        "仅已核验的 XLPE 表内额定电压及单芯 / 三芯结构；第 2 类导体 R₂₀ 已核验条目，其他材料、导体类别或表外值保留未覆盖。",
        "GB/T 11017.1—2024 和 11017.2—2014 原文缺失；其最薄点与中压铜丝间隙算法不由其他版本代替。",
        "第 1 部分内衬层、护套、最薄点及成缆分支尚未覆盖；附加包带和未知构造阻止完整假定直径链。",
        "设计输入、厂家上限与实测值分别标记；缺少短路故障要求时金属屏蔽截面不作合格判定。本核对不批准要求、型号或产品认证。"
      ],
      "category": "data-standard",
      "description": "仅已核验的 XLPE 表内额定电压及单芯 / 三芯结构；第 2 类导体 R₂₀ 已核验条目，其他材料、导体类别或表外值保留未覆盖。；GB/T 11017.1—2024 和 11017.2—2014 原文缺失；其最薄点与中压铜丝间隙算法不由其他版本代替。",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cable_type_id": {
            "type": "string",
            "title": "电缆型号",
            "description": "从工程型号库选择已有型号，禁止自由填写不存在的编号。",
            "x-unit": {
              "si": null,
              "display": null,
              "scale": 1,
              "offset": 0
            },
            "x-group": "model",
            "x-order": 0,
            "x-level": "basic",
            "x-bind": {
              "type": "cable_type",
              "scope": "workspace",
              "multiple": false,
              "keyed": false,
              "read_only": false
            }
          }
        }
      },
      "x-groups": [
        {
          "id": "model",
          "title": "模型与对象",
          "order": 0
        },
        {
          "id": "operating",
          "title": "工况与目标",
          "order": 1
        },
        {
          "id": "materials",
          "title": "材料与构造",
          "order": 2
        },
        {
          "id": "physics",
          "title": "物理方法",
          "order": 3
        },
        {
          "id": "numerical",
          "title": "数值与离散",
          "order": 4
        },
        {
          "id": "evidence",
          "title": "来源与证据",
          "order": 5
        }
      ],
      "input_contract": {
        "input_sources": [
          "domain",
          "study"
        ],
        "binding": {
          "type": "domain",
          "scope": "workspace",
          "read_only": true
        }
      },
      "preview": true,
      "preview_timeout_s": 8,
      "x-headline": [
        {
          "key": "x-cablesim.standard-failed-count",
          "title": "不满足项数",
          "unit": {
            "si": "1",
            "display": "1",
            "scale": 1,
            "offset": 0
          },
          "aggregate": "first",
          "artifact": "x-cablesim.headline-witness",
          "source_artifact": "x-cablesim.standard-check"
        }
      ],
      "study_tasks": []
    },
