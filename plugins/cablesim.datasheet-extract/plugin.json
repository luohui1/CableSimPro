  "capabilities": [
    {
      "id": "inspect",
      "kind": "method",
      "title": "检查 PDF 页数与文字层",
      "method_version": "DATASHEET-0.1.0",
      "analysis": "extraction",
      "input_schema": "cablesim.datasheet/1",
      "outputs": [
        {
          "key": "x-cablesim.datasheet.count",
          "type": "quantity",
          "per": "section",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.datasheet",
          "required": true
        }
      ],
      "validation": {
        "level": "interface-tested",
        "cases": [
          "tests/test_datasheet_import.py"
        ]
      },
      "limitations": [
        "仅候选；逐项人工核对和人工批准后才生成型号新版本草稿。",
        "PDF 文本层优先；扫描页默认离线 CPU OCR，可选云端须明确外发确认。",
        "无法唯一定位型号、字段或单位时标歧义；不推测缺项。"
      ]
    },
