{
  "schema": "cablesim.plugin/2",
  "id": "cablesim.datasheet-extract",
  "version": "0.1.1",
  "name": "厂家资料参数提取",
  "icon": "assets/icon.svg",
  "description": "PDF 文字层与表格优先；保留型号、页码、原文坐标和单位，模型输出只作为待人工核对候选。",
  "publisher": {
    "id": "cablesim",
    "name": "CableSimPro"
  },
  "host_api": {
    "major": 2,
    "min_minor": 1
  },
  "license": {
    "spdx": "LicenseRef-Project-Undeclared",
    "review_required": false
  },
  "platforms": [
    "windows-x64",
    "linux-x64",
    "darwin-arm64",
    "darwin-x64"
  ],
  "runtime": {
    "kind": "python",
    "python": ">=3.11,<3.14",
    "entry": "src/cablesim_datasheet_extract/main.py"
  },
  "permissions": [
    "study.run",
    "artifact.write",
    "project.propose"
  ],
  "dependencies": [],
  "resources": {
    "timeout_s": 90,
    "memory_mb": 1024,
    "network": "none"
