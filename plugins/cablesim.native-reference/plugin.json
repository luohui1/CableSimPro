        "上游网格与温度场必须引用同工程、同输入的已封存运行，逐文件核验SHA256。"
      ]
    },
    {
      "kind": "method",
      "id": "line-source-crosscheck",
      "title": "有限域与半空间线源交叉校核",
      "method_version": "native-crosscheck/0.1.0",
      "analysis": "crosscheck",
