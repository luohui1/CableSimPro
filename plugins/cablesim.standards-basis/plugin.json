{
  "schema": "cablesim.plugin/2",
  "id": "cablesim.standards-basis",
  "version": "0.3.0",
  "name": "标准依据库",
  "icon": "assets/icon.svg",
  "description": "离线只读查询已逐格核验的标准尺寸、电阻和试验数值，返回适用条件、原页出处与摘要；查询不会批准工程要求。",
  "publisher": {
    "id": "cablesim",
    "name": "CableSimPro"
  },
  "host_api": {
    "major": 2,
    "min_minor": 1
  },
  "license": {
    "spdx": "LicenseRef-User-Supplied-Standards-Excerpts",
    "review_required": true
  },
  "platforms": [
    "windows-x64",
    "linux-x64",
    "darwin-arm64",
    "darwin-x64"
  ],
  "runtime": {
    "kind": "python",
    "python": ">=3.11,<3.14",
    "entry": "src/cablesim_standards_basis/main.py"
  },
  "permissions": [
    "study.run",
    "artifact.write"
  ],
  "dependencies": [],
  "resources": {
    "timeout_s": 15,
    "memory_mb": 128,
    "network": "none"
  },
  "capabilities": [
    {
      "id": "lookup",
      "kind": "method",
      "title": "按标准、条款和条件查询依据",
      "method_version": "0.3.0",
      "read_only": true,
      "analysis": "standards_lookup",
      "input_schema": "cablesim.standards-query/1",
      "description": "返回标准原值及单位、条件、页码、双路核验与SHA256；空格、缺项和版本变化明确区分。",
      "category": "data-standard",
      "outputs": [
        {
          "key": "x-cablesim.standards-basis.count",
          "type": "quantity",
          "per": "section",
          "required": true
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.standards-basis",
          "required": true
        }
      ],
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "validation": {
        "level": "interface-tested",
        "cases": [
          "tests/test_standards_basis.py",
          "tests/test_standards_basis_query.py",
          "tests/test_standards_basis_round.py"
        ]
      },
      "limitations": [
        "仅提供结构化依据，不执行标准公式、不产生工程合格结论、不批准型号要求。",
        "仅覆盖文档列出的完整表及条款；不外推、不跨版本补值；合金派生、协商例外及修约计算须下一轮接入。",
        "标准全文未打包；用户持有正文的使用权限尚未评估，发布或对外分发前需人工审查。"
      ]
    }
  ],
