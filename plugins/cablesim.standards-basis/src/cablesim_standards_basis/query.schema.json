  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "catalog"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "maxProperties": 2
      },
      "else": {
        "required": [
          "standard",
          "edition",
          "locator"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "list"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "not": {
          "required": [
            "record_id"
          ]
        },
        "properties": {
          "conditions": {
            "maxProperties": 0
          }
        }
      },
      "else": {
        "if": {
          "not": {
            "properties": {
              "operation": {
                "const": "catalog"
              }
            },
            "required": [
              "operation"
            ]
          }
        },
        "then": {
          "required": [
            "quantity"
          ]
        }
      }
    }
