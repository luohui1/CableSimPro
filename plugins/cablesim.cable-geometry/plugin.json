{
  "schema": "cablesim.plugin/2",
  "id": "cablesim.cable-geometry",
  "version": "1.0.1",
  "name": "电缆实体建模",
  "icon": "assets/icon.svg",
  "description": "单芯及多芯电缆实体、显式扇形轮廓、间隙填充、内衬、双带与丝铠装；结构推导外径和理论用料；同源 OCCT 实体与 STEP。",
  "publisher": {
    "id": "cablesim",
    "name": "CableSimPro"
  },
  "host_api": {
    "major": 2,
    "min_minor": 1
  },
  "license": {
    "spdx": "LicenseRef-Project-Undeclared",
    "review_required": false
  },
  "platforms": [
    "windows-x64",
    "linux-x64",
    "darwin-arm64",
    "darwin-x64"
  ],
  "runtime": {
    "kind": "python",
    "python": ">=3.11,<3.14",
    "entry": "src/cablesim_cable_geometry/main.py"
  },
  "permissions": [
    "study.run",
    "artifact.write"
  ],
  "dependencies": [],
  "resources": {
    "timeout_s": 120,
    "memory_mb": 2048,
    "network": "none"
  },
  "capabilities": [
    {
      "kind": "method",
      "id": "concentric-model",
      "title": "电缆结构 CAD 实体",
      "method_version": "1.0.0",
      "analysis": "geometry",
      "input_schema": "cablesim.domain/1",
      "outputs": [
        {
          "key": "x-cablesim.outer-diameter",
          "type": "quantity",
          "per": "cable",
          "required": true
        },
        {
          "key": "x-cablesim.envelope-volume",
          "type": "quantity",
          "per": "core",
          "required": true
        },
        {
          "key": "x-cablesim.material-volume",
          "type": "quantity",
          "per": "core",
          "required": false
        }
      ],
      "artifacts": [
        {
          "type": "x-cablesim.cad-model",
          "required": true
        },
        {
          "type": "x-cablesim.headline-witness",
          "required": false
        }
      ],
      "validation": {
        "level": "unverified",
        "cases": []
      },
      "limitations": [
        "支持最多16芯、128层；圆形及明确圆弧直径、夹角、朝向的扇形轮廓，芯坐标必须明确且不重叠。不支持波纹与中空结构；扇形离散丝/带层须专用轮廓。",
        "圆绞合与丝层需要根数、丝径和节距；紧压与分割导体按设计外径生成包络，未建单丝压实或分割缝。用料按标称截面、密度及明确绞入系数计算，缺系数时不提供导体用料。",
        "质量只在结构与材料密度齐全时提供；双带需单带厚度、带宽与最大轴向间隙。搭盖金属带用料按单带厚度及搭盖率，径向显示包络体积不作为金属量。线芯按截面直线拉伸，不含成缆扭转、接触形变与制造公差。"
      ],
      "category": "modeling",
      "description": "支持最多16芯、128层；圆形及明确圆弧直径、夹角、朝向的扇形轮廓，芯坐标必须明确且不重叠。不支持波纹与中空结构；扇形离散丝/带层须专用轮廓。；圆绞合与丝层需要根数、丝径和节距；紧压与分割导体按设计外径生成包络，未建单丝压实或分割缝。用料按标称截面、密度及明确绞入系数计算，缺系数时不提供导体用料。",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cable_type_id": {
            "type": "string",
            "title": "电缆型号",
            "description": "从工程型号库选择已有型号，禁止自由填写不存在的编号。",
            "x-unit": {
              "si": null,
              "display": null,
              "scale": 1,
              "offset": 0
            },
            "x-group": "model",
            "x-order": 0,
