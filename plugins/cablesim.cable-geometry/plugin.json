            "x-bind": {
              "type": "cable_type",
              "scope": "workspace",
              "multiple": false,
              "keyed": false,
              "read_only": false
            }
          },
          "length_m": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1,
            "default": 0.18,
            "title": "建模长度",
            "description": "轴向几何或电场模型的长度，几何展示长度不代表订单长度。",
            "x-unit": {
              "si": "m",
              "display": "m",
              "scale": 1,
              "offset": 0
            },
            "x-group": "materials",
            "x-order": 1,
            "x-level": "basic",
            "x-default-basis": {
              "kind": "engineering",
              "reference": "plugins/cablesim.cable-geometry/src 的 concentric-model 输入校验；契约适用范围与显式工程输入；物理取值须附资料来源，不代表通用标准限值。"
            },
            "x-range-basis": {
              "kind": "engineering",
              "reference": "plugins/cablesim.cable-geometry/src 的 concentric-model 输入校验；契约适用范围与显式工程输入；物理取值须附资料来源，不代表通用标准限值。"
            }
          },
          "include_exact": {
            "type": "boolean",
            "default": true,
            "title": "生成精确实体",
            "description": "请求原生几何实体；实际构造缺失时仍保留明确的包络限制。",
            "x-unit": {
              "si": null,
              "display": null,
              "scale": 1,
              "offset": 0
