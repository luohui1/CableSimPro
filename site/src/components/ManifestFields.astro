---
// 列出插件清单 JSON Schema（plugin-spec/manifest.schema.json）中某个对象的字段、类型和是否必填。
import schema from '../../.generated/manifest-schema.json';

interface Props {
  /** $defs 中的对象名；省略时为清单根对象 */
  def?: string;
}

type Node = Record<string, any>;
const defs = (schema as Node).$defs as Record<string, Node>;
const target: Node = Astro.props.def ? defs[Astro.props.def] : (schema as Node);
if (!target) throw new Error(`manifest.schema.json 中没有 ${Astro.props.def}`);
const required = new Set<string>(target.required ?? []);

function typeOf(node: Node | undefined): string {
  if (!node) return '任意';
  if (node.$ref) return String(node.$ref).split('/').pop() as string;
  if (node.const !== undefined) return JSON.stringify(node.const);
  if (node.enum) return node.enum.map((v: unknown) => JSON.stringify(v)).join(' | ');
  if (node.anyOf) return [...new Set(node.anyOf.map((n: Node) => typeOf(n)))].join(' | ');
  if (node.type === 'array') return `${typeOf(node.items)}[]`;
  if (node.type === 'object' && node.additionalProperties && typeof node.additionalProperties === 'object')
    return `{ 键: ${typeOf(node.additionalProperties)} }`;
  return node.type ?? '任意';
}
const rows = Object.entries((target.properties ?? {}) as Record<string, Node>).map(([key, node]) => ({
  key,
  type: typeOf(node),
  required: required.has(key),
}));
---

<table>
  <thead>
    <tr>
      <th>字段</th>
      <th>类型</th>
      <th>必填</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <td>
            <code>{row.key}</code>
          </td>
          <td>
            <code>{row.type}</code>
          </td>
          <td>{row.required ? '是' : '否'}</td>
        </tr>
      ))
    }
  </tbody>
</table>
