{
  "name": "cablesimpro-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "content": "node scripts/prepare-content.mjs",
    "dev": "node scripts/prepare-content.mjs && astro dev",
    "build": "node scripts/prepare-content.mjs && node --max-old-space-size=1536 node_modules/astro/bin/astro.mjs build && node scripts/check-internal.mjs",
    "check:internal": "node scripts/check-internal.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:search": "node scripts/check-search.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.12",
    "astro-mermaid": "2.2.0",
    "katex": "0.16.47",
    "mermaid": "12.3.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "sharp": "0.35.5",
    "starlight-image-zoom": "0.16.3",
    "starlight-openapi": "0.27.1"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
