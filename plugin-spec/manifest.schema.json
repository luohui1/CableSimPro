{
  "$defs": {
    "ArtifactSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "pattern": "^(x-[a-z0-9-]+\\.)?[a-z0-9.-]+$",
          "title": "Type",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "required"
      ],
      "title": "ArtifactSpec",
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "method",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "method_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Method Version",
          "type": "string"
        },
        "analysis": {
          "pattern": "^[a-z_]+$",
          "title": "Analysis",
          "type": "string"
        },
        "input_schema": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Input Schema",
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/Output"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactSpec"
          },
          "maxItems": 20,
          "title": "Artifacts",
          "type": "array"
        },
        "validation": {
          "$ref": "#/$defs/Validation"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "method_version",
        "analysis",
        "input_schema",
        "outputs",
        "validation",
        "limitations"
      ],
      "title": "Capability",
      "type": "object"
    },
    "HostApi": {
      "additionalProperties": false,
      "properties": {
        "major": {
          "title": "Major",
          "type": "integer"
        },
        "min_minor": {
          "minimum": 0,
          "title": "Min Minor",
          "type": "integer"
        }
      },
      "required": [
        "major",
        "min_minor"
      ],
      "title": "HostApi",
      "type": "object"
    },
    "License": {
      "additionalProperties": false,
      "properties": {
        "spdx": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Spdx",
          "type": "string"
        },
        "review_required": {
          "title": "Review Required",
          "type": "boolean"
        }
      },
      "required": [
        "spdx",
        "review_required"
      ],
      "title": "License",
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "per": {
          "enum": [
            "circuit",
            "cable",
            "core",
            "section"
          ],
          "title": "Per",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "type",
        "per",
        "required"
      ],
      "title": "Output",
      "type": "object"
    },
    "PackageFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^(src/[A-Za-z0-9_./-]+|assets/icon\\.svg)$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 20971520,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "PackageFile",
      "type": "object"
    },
    "Publisher": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Publisher",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "timeout_s": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout S",
          "type": "integer"
        },
        "memory_mb": {
          "maximum": 65536,
          "minimum": 16,
          "title": "Memory Mb",
          "type": "integer"
        },
        "network": {
          "const": "none",
          "title": "Network",
          "type": "string"
        }
      },
      "required": [
        "timeout_s",
        "memory_mb",
        "network"
      ],
      "title": "Resources",
      "type": "object"
    },
    "Runtime": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "python",
          "title": "Kind",
          "type": "string"
        },
        "python": {
          "title": "Python",
          "type": "string"
        },
        "entry": {
          "pattern": "^src/[A-Za-z0-9_./-]+\\.py$",
          "title": "Entry",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "python",
        "entry"
      ],
      "title": "Runtime",
      "type": "object"
    },
    "Validation": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "unverified",
            "interface-tested",
            "analytic-benchmark",
            "reference-benchmark",
            "field-validated"
          ],
          "title": "Level",
          "type": "string"
        },
        "cases": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Cases",
          "type": "array"
        }
      },
      "required": [
        "level"
      ],
      "title": "Validation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "cablesim.plugin/2",
      "title": "Schema",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "title": "Version",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "icon": {
      "anyOf": [
        {
          "const": "assets/icon.svg",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Icon"
    },
    "publisher": {
      "$ref": "#/$defs/Publisher"
    },
    "host_api": {
      "$ref": "#/$defs/HostApi"
    },
    "license": {
      "$ref": "#/$defs/License"
    },
    "platforms": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Platforms",
      "type": "array"
    },
    "runtime": {
      "$ref": "#/$defs/Runtime"
    },
    "permissions": {
      "items": {
        "enum": [
          "project.read",
          "study.run",
          "artifact.read",
          "artifact.write",
          "project.propose"
        ],
        "type": "string"
      },
      "title": "Permissions",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 0,
      "title": "Dependencies",
      "type": "array"
    },
    "resources": {
      "$ref": "#/$defs/Resources"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/PackageFile"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "name",
    "publisher",
    "host_api",
    "license",
    "platforms",
    "runtime",
    "permissions",
    "dependencies",
    "resources",
    "capabilities",
    "files"
  ],
  "title": "Manifest",
  "type": "object"
}
