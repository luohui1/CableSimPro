{
  "$defs": {
    "AgentSkill": {
      "additionalProperties": false,
      "properties": {
        "context_schema": {
          "const": "cablesim.workflow-context/1",
          "title": "Context Schema",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/SkillStep"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "effects": {
          "items": {
            "enum": [
              "read",
              "calculate",
              "propose"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Effects",
          "type": "array"
        },
        "engineering_approval": {
          "const": false,
          "default": false,
          "title": "Engineering Approval",
          "type": "boolean"
        },
        "human_approval_required_for": {
          "items": {
            "enum": [
              "workspace.change",
              "engineering.accept",
              "external.send"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Human Approval Required For",
          "type": "array"
        }
      },
      "required": [
        "context_schema",
        "steps",
        "effects"
      ],
      "title": "AgentSkill",
      "type": "object"
    },
    "ArtifactSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "pattern": "^(x-[a-z0-9-]+\\.)?[a-z0-9.-]+$",
          "title": "Type",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "required"
      ],
      "title": "ArtifactSpec",
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "method",
            "report-template",
            "agent-skill"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "solver": {
          "default": "local",
          "description": "求解位置：local 仅本机，slurm 仅超算，either 两者均可；省略时按 local。",
          "enum": [
            "local",
            "slurm",
            "either"
          ],
          "title": "Solver",
          "type": "string"
        },
        "method_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Method Version",
          "type": "string"
        },
        "analysis": {
          "pattern": "^[a-z_]+$",
          "title": "Analysis",
          "type": "string"
        },
        "input_schema": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Input Schema",
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/Output"
          },
          "maxItems": 100,
          "title": "Outputs",
          "type": "array"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactSpec"
          },
          "maxItems": 20,
          "title": "Artifacts",
          "type": "array"
        },
        "validation": {
          "$ref": "#/$defs/Validation"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 700,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "parameter_schema": {
          "$ref": "#/$defs/ParameterSchema"
        },
        "input_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x-groups": {
          "items": {
            "$ref": "#/$defs/ParameterGroup"
          },
          "title": "X-Groups",
          "type": "array"
        },
        "x-headline": {
          "items": {
            "$ref": "#/$defs/Headline"
          },
          "maxItems": 3,
          "title": "X-Headline",
          "type": "array"
        },
        "preview": {
          "default": false,
          "title": "Preview",
          "type": "boolean"
        },
        "preview_timeout_s": {
          "default": 8,
          "maximum": 15,
          "minimum": 1,
          "title": "Preview Timeout S",
          "type": "integer"
        },
        "study_tasks": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Study Tasks",
          "type": "array"
        },
        "category": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "x-temperature-field-binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemperatureFieldBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "report_template": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportTemplate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "agent_skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentSkill"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "read_only": {
          "default": false,
          "title": "Read Only",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "method_version",
        "analysis",
        "input_schema",
        "validation",
        "limitations"
      ],
      "title": "Capability",
      "type": "object"
    },
    "Headline": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/UnitDisplay"
        },
        "aggregate": {
          "default": "first",
          "enum": [
            "minimum",
            "maximum",
            "first"
          ],
          "title": "Aggregate",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "artifact": {
          "description": "Same-case validated artifact required for this answer.",
          "maxLength": 120,
          "minLength": 1,
          "title": "Artifact",
          "type": "string"
        },
        "source_artifact": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact engineering artifact accompanied by the answer witness.",
          "title": "Source Artifact"
        }
      },
      "required": [
        "key",
        "title",
        "unit",
        "artifact"
      ],
      "title": "Headline",
      "type": "object"
    },
    "HostApi": {
      "additionalProperties": false,
      "properties": {
        "major": {
          "title": "Major",
          "type": "integer"
        },
        "min_minor": {
          "minimum": 0,
          "title": "Min Minor",
          "type": "integer"
        }
      },
      "required": [
        "major",
        "min_minor"
      ],
      "title": "HostApi",
      "type": "object"
    },
    "InputContract": {
      "additionalProperties": false,
      "properties": {
        "input_sources": {
          "items": {
            "enum": [
              "domain",
              "study"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Sources",
          "type": "array"
        },
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "standalone_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "standalone_parameter_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "input_sources"
      ],
      "title": "InputContract",
      "type": "object"
    },
    "License": {
      "additionalProperties": false,
      "properties": {
        "spdx": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Spdx",
          "type": "string"
        },
        "review_required": {
          "title": "Review Required",
          "type": "boolean"
        }
      },
      "required": [
        "spdx",
        "review_required"
      ],
      "title": "License",
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "per": {
          "enum": [
            "circuit",
            "cable",
            "core",
            "section"
          ],
          "title": "Per",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "type",
        "per",
        "required"
      ],
      "title": "Output",
      "type": "object"
    },
    "PackageFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^(src/[A-Za-z0-9_./-]+|assets/[A-Za-z0-9_-]+\\.(svg|webp|html|css|json))$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 20971520,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "PackageFile",
      "type": "object"
    },
    "ParameterBasis": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "standard",
            "method",
            "numerical",
            "engineering",
            "source",
            "binding"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "title": "ParameterBasis",
      "type": "object"
    },
    "ParameterBinding": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "domain",
            "section",
            "load",
            "cable_type",
            "circuit",
            "cable",
            "core",
            "layer",
            "material",
            "duct",
            "artifact",
            "source_document",
            "model",
            "reference_case",
            "mesh",
            "region",
            "node",
            "standard",
            "evidence"
          ],
          "title": "Type",
          "type": "string"
        },
        "multiple": {
          "default": false,
          "title": "Multiple",
          "type": "boolean"
        },
        "keyed": {
          "default": false,
          "title": "Keyed",
          "type": "boolean"
        },
        "read_only": {
          "default": false,
          "title": "Read Only",
          "type": "boolean"
        },
        "scope": {
          "default": "workspace",
          "enum": [
            "workspace",
            "input",
            "library",
            "run"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ParameterBinding",
      "type": "object"
    },
    "ParameterGroup": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "title",
        "order"
      ],
      "title": "ParameterGroup",
      "type": "object"
    },
    "ParameterMetadata": {
      "additionalProperties": true,
      "description": "JSON Schema keywords are retained; UI extension keywords are typed here.",
      "properties": {
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "[\\u3400-\\u9fff]",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "maxLength": 700,
          "minLength": 1,
          "pattern": "[\\u3400-\\u9fff]",
          "title": "Description",
          "type": "string"
        },
        "x-unit": {
          "$ref": "#/$defs/UnitDisplay"
        },
        "x-unit-by": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterUnitCases"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x-group": {
          "maxLength": 60,
          "minLength": 1,
          "title": "X-Group",
          "type": "string"
        },
        "x-order": {
          "minimum": 0,
          "title": "X-Order",
          "type": "integer"
        },
        "x-level": {
          "enum": [
            "basic",
            "advanced",
            "expert"
          ],
          "title": "X-Level",
          "type": "string"
        },
        "x-bind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x-default-basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x-range-basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x-editor-reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X-Editor-Reason"
        },
        "x-enum-labels": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X-Enum-Labels"
        },
        "x-runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeUnit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "title",
        "description",
        "x-unit",
        "x-group",
        "x-order",
        "x-level"
      ],
      "title": "ParameterMetadata",
      "type": "object"
    },
    "ParameterSchema": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "object",
          "default": "object",
          "title": "Type",
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ParameterMetadata"
          },
          "title": "Properties"
        },
        "$defs": {
          "additionalProperties": true,
          "title": "$Defs",
          "type": "object"
        },
        "additionalProperties": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "default": false,
          "title": "Additionalproperties"
        }
      },
      "title": "ParameterSchema",
      "type": "object"
    },
    "ParameterUnitCases": {
      "additionalProperties": false,
      "properties": {
        "selector": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Selector",
          "type": "string"
        },
        "cases": {
          "additionalProperties": {
            "$ref": "#/$defs/UnitDisplay"
          },
          "minProperties": 1,
          "title": "Cases",
          "type": "object"
        }
      },
      "required": [
        "selector",
        "cases"
      ],
      "title": "ParameterUnitCases",
      "type": "object"
    },
    "Presentation": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "calculation",
            "modeling",
            "simulation",
            "data-standard",
            "report",
            "agent-skill"
          ],
          "title": "Category",
          "type": "string"
        },
        "category_title": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Category Title",
          "type": "string"
        },
        "assets": {
          "items": {
            "$ref": "#/$defs/PresentationAsset"
          },
          "maxItems": 6,
          "minItems": 2,
          "title": "Assets",
          "type": "array"
        },
        "validation_note": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Validation Note",
          "type": "string"
        }
      },
      "required": [
        "category",
        "category_title",
        "assets",
        "validation_note"
      ],
      "title": "Presentation",
      "type": "object"
    },
    "PresentationAsset": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "cover",
            "method",
            "validation"
          ],
          "title": "Role",
          "type": "string"
        },
        "path": {
          "pattern": "^assets/[a-z][a-z0-9-]*\\.(webp|svg)$",
          "title": "Path",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "image/webp",
            "image/svg+xml"
          ],
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "role",
        "path",
        "title",
        "description",
        "media_type"
      ],
      "title": "PresentationAsset",
      "type": "object"
    },
    "Publisher": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Publisher",
      "type": "object"
    },
    "ReportSection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "pattern": "[\\u3400-\\u9fff]",
          "title": "Title",
          "type": "string"
        },
        "source": {
          "enum": [
            "inputs",
            "results",
            "artifacts",
            "provenance",
            "limitations"
          ],
          "title": "Source",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "source"
      ],
      "title": "ReportSection",
      "type": "object"
    },
    "ReportTemplate": {
      "additionalProperties": false,
      "properties": {
        "context_schema": {
          "const": "cablesim.report-context/1",
          "title": "Context Schema",
          "type": "string"
        },
        "format": {
          "const": "html",
          "title": "Format",
          "type": "string"
        },
        "entry": {
          "pattern": "^assets/[a-z][a-z0-9-]*\\.html$",
          "title": "Entry",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/ReportSection"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Sections",
          "type": "array"
        },
        "engineering_approval": {
          "const": false,
          "default": false,
          "title": "Engineering Approval",
          "type": "boolean"
        }
      },
      "required": [
        "context_schema",
        "format",
        "entry",
        "sections"
      ],
      "title": "ReportTemplate",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "timeout_s": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout S",
          "type": "integer"
        },
        "memory_mb": {
          "maximum": 65536,
          "minimum": 16,
          "title": "Memory Mb",
          "type": "integer"
        },
        "network": {
          "const": "none",
          "title": "Network",
          "type": "string"
        }
      },
      "required": [
        "timeout_s",
        "memory_mb",
        "network"
      ],
      "title": "Resources",
      "type": "object"
    },
    "Runtime": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "python",
          "title": "Kind",
          "type": "string"
        },
        "python": {
          "title": "Python",
          "type": "string"
        },
        "entry": {
          "pattern": "^src/[A-Za-z0-9_./-]+\\.py$",
          "title": "Entry",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "python",
        "entry"
      ],
      "title": "Runtime",
