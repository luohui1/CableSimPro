# Copy this file to .env in the repository root, edit locally, then restart.
# NEVER commit .env or send live credentials in chat.
# Local text/PDF extraction, physics, library and selection work without keys.

# OCR options: disabled | mistral | gateway
CABLESIM_OCR_PROVIDER=disabled
CABLESIM_OCR_API_KEY=
# Mistral uses https://api.mistral.ai/v1/ocr by default (leave URL commented).
# CABLESIM_OCR_URL=https://api.mistral.ai/v1/ocr
# CABLESIM_OCR_MODEL=mistral-ocr-latest
# gateway must implement docs/DESIGN_V04.md's versioned normalization contract.
# CABLESIM_OCR_URL=https://your-trusted-service.example/v1/ocr

# Model must support function calls. Set the provider's actual model ID.
CABLESIM_AGENT_PROTOCOL=responses
CABLESIM_AGENT_BASE_URL=https://api.openai.com/v1
CABLESIM_AGENT_API_KEY=
CABLESIM_AGENT_MODEL=
# Compatibility fallback: OPENAI_API_KEY is accepted if CABLESIM_AGENT_API_KEY is empty.
# For another compatible provider set protocol=chat_completions and its base URL.
# The browser shows only configuration status; it never receives keys.

# Optional local-only gateway over HTTP; disabled by default.
# CABLESIM_ALLOW_LOCAL_HTTP=1
